# Terraform configuration for Okta users generated by OktaTfUserRoBuilder (okta-users)

terraform {
  required_providers {
    okta = {
      source  = "okta/okta"
      version = ">= 6.0"
    }

    external = {
      source = "hashicorp/external"
    }
  }

  backend "s3" {
  }
}

provider "okta" {
  org_name = "noaa"
  base_url = "okta.com"
  alias    = "okta_users"
}

# Sensitive values (stage 34): the same ENC[age:...] ciphertext the configuration carries, decrypted at plan time by the identity in CSIS_CONFIG_IDENTITY; never committed in clear
data "external" "sensitive" {
  program = [
    "cs-image-system",
    "decrypt",
    "--json",
  ]
  query = {
    email_mykel_alvis   = "mykel.alvis@ENC[age:]",
    email_zachary_wills = "zachary.wills@ENC[age:]",
  }
}
locals {
  sensitive = sensitive(data.external.sensitive.result)
}