# Terraform configuration for GCE instances generated by TofuGceInstanceBuilder (tofu-gce)
terraform {
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = ">= 5.0.0"
    }
  }

  backend "s3" {
  }
}
provider "google" {
  project = "csis-sandbox"
  region  = "us-east1"
  zone    = "us-east1-b"
  alias   = "tofu_gce"
}
variable "ephemeral_present" {
  type        = bool
  default     = true
  description = "false = the run's ephemeral instances are torn down (stage 10.1)"
}
variable "walk_gce_1_image" {
  type    = string
  default = ""
}
variable "sft_enrollment_token" {
  type        = string
  default     = ""
  description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
  sensitive   = true
}
data "terraform_remote_state" "aws_ebs" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/aws_ebs.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}
data "terraform_remote_state" "gcp_pd" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/gcp_pd.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}
data "terraform_remote_state" "opa_groups" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/opa_groups.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}