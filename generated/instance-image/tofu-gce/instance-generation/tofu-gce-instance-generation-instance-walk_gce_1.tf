# Terraform module call for GCE instance walk-gce-1 generated by TofuGceInstanceBuilder (tofu-gce)
# owning group: walk_team (via image team-node); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_walk_gce_1" {
  source       = "../../../../tfmodules/gce_instance"
  providers    = { google = google.tofu_gce }
  count        = var.ephemeral_present ? 1 : 0
  name         = "walk-gce-1"
  image        = var.walk_gce_1_image
  image_family = "team-node"
  machine_type = "e2-small"
  zone         = "us-east1-b"
  subnetwork   = "projects/csis-sandbox/regions/us-east1/subnetworks/default"
  public_ip    = false
  labels       = { "role" = "node" }
  startup_script = templatefile("${path.module}/user-data-walk_gce_1.sh.tftpl", {
    "efs"                  = {}
    "filestore"            = {}
    "group_gid"            = data.terraform_remote_state.opa_groups.outputs.group_gids["walk_team"]
    "sft_enrollment_token" = var.sft_enrollment_token
  })
  attached_disks = {
    "walk-data" = {
      "device_name"    = "walk-data"
      "disk_self_link" = data.terraform_remote_state.gcp_pd.outputs.storage_walk_data.self_link
    }
  }
}