# Terraform module call for instance walk-node-1 generated by TofuInstanceBuilder (tofu-aws)
# owning group: walk_team (via image team-node); launch parameters recorded in meta-state/launch-params.yaml (N26)
module "instance_walk_node_1" {
  source                      = "../../../../tfmodules/aws_instance"
  providers                   = { aws = aws.tofu_aws }
  name                        = "walk-node-1"
  ami_id                      = "ami-03a8cef5e12cd1b50"
  instance_type               = "t3.medium"
  associate_public_ip_address = false
  vpc_security_group_ids      = [aws_security_group.csis_instances.id, "sg-03015ec107ae5f81a"]
  subnet_id                   = "subnet-09f79018af845358a"
  iam_instance_profile        = "AmazonSSMRoleForInstancesQuickSetup"
  tags                        = { "role" = "node" }
  user_data = templatefile("${path.module}/user-data-walk_node_1.sh.tftpl", {
    "ebs" = {
      "data" = {
        "device_name" = "/dev/xvdf"
        "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_data.volume_id
      }
    }
    "efs"                  = {}
    "group_gid"            = data.terraform_remote_state.opa_groups.outputs.group_gids["walk_team"]
    "sft_enrollment_token" = (var.sft_enrollment_token != "" ? var.sft_enrollment_token : data.terraform_remote_state.opa_groups.outputs.group_enrollment_tokens["walk_team"])
  })
  ebs_volumes = {
    "data" = {
      "device_name" = "/dev/xvdf"
      "volume_id"   = data.terraform_remote_state.aws_ebs.outputs.storage_data.volume_id
    }
  }
}