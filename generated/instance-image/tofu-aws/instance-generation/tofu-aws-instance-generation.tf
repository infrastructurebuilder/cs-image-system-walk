# Terraform configuration for instances generated by TofuInstanceBuilder (tofu-aws)
terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 4.0.0"
    }
  }

  backend "s3" {
  }
}
provider "aws" {
  region  = "us-east-2"
  profile = "noaa"
  alias   = "tofu_aws"
}
variable "walk_node_1_ami_id" {
  type    = string
  default = ""
}
variable "sft_enrollment_token" {
  type        = string
  default     = ""
  description = "Identity enrollment token handed to instances at launch (TF_VAR_...); empty = no enrollment"
  sensitive   = true
}
data "terraform_remote_state" "aws_ebs" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/aws_ebs.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}
data "terraform_remote_state" "gcp_pd" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/gcp_pd.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}
data "terraform_remote_state" "opa_groups" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/opa_groups.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}
data "aws_vpc" "csis_instances" {
  provider = aws.tofu_aws
  id       = "vpc-0c78d0d63b7a100df"
}
resource "aws_security_group" "csis_instances" {
  provider    = aws.tofu_aws
  name_prefix = "csis-instances-"
  description = "cs-image-system instances: SSH from the session relay; all egress"
  vpc_id      = data.aws_vpc.csis_instances.id
  ingress {
    from_port       = 22
    to_port         = 22
    protocol        = "tcp"
    security_groups = ["sg-03015ec107ae5f81a"]
  }
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }
  tags = { Name = "csis-instances" }
  # replacements must create the successor first: instances
  # wear this group, so a delete-first plan hits
  # DependencyViolation (found live)
  lifecycle { create_before_destroy = true }
}