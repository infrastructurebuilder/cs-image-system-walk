# Terraform module call for storage walk-data generated by TofuPdStorageBuilder (gcp-pd)
# allowed groups: walk_team (gids by remote-state reference); public_read=false; requested state: active
module "storage_walk_data" {
  source    = "../../../../tfmodules/gcp_storage_pd"
  providers = { google = google.gcp_pd }
  name      = "walk-data"
  size      = 10
  disk_type = "pd-standard"
  labels    = { "csis_group_walk_team" = "true", "csis_storage" = "walk-data", "project" = "walk", "purpose" = "data" }
  zone      = "us-east1-b"
}
output "storage_walk_data" {
  value       = module.storage_walk_data
  description = "Outputs of storage walk-data for remote-state consumers"
}