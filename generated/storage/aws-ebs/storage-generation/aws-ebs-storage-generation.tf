# Terraform configuration for storages generated by TofuEbsStorageBuilder (aws-ebs)
terraform {
  required_providers {
    aws = {
      source = "hashicorp/aws"
    }
  }

  backend "s3" {
  }
}
provider "aws" {
  region  = "us-east-2"
  profile = "noaa"
  alias   = "aws_ebs"
}
data "terraform_remote_state" "opa_groups" {
  backend = "s3"

  config = {
    bucket  = "csis-walk-tfstate-514190660293"
    key     = "statefiles/cs-image-system-walk/opa_groups.tfstate"
    region  = "us-east-2"
    profile = "noaa"
  }
}