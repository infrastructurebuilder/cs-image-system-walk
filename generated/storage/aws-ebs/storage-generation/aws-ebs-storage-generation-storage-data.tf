# Terraform module call for storage data generated by TofuEbsStorageBuilder (aws-ebs)
# allowed groups: walk_team (gids by remote-state reference); public_read=false; requested state: active
module "storage_data" {
  source      = "../../../../tfmodules/aws_storage_ebs"
  providers   = { aws = aws.aws_ebs }
  volume_type = "gp3"
  encrypted   = true
  name        = "data"
  size        = 100
  subnet_id   = "subnet-09f79018af845358a"
  tags        = { "Project" = "cs-image-system-walk", "purpose" = "data" }
}
output "storage_data" {
  value       = module.storage_data
  description = "Outputs of storage data for remote-state consumers"
}