# Build configuration for Packer EBS Ansible Builder generated by PackerEbsImageBuilder (packer-ebs)
build {
  name = "packer-ebs-block-000"
  sources = [
    "source.amazon-ebs.el10"
  ]
  # OS update for base image el10 (policy=security, packages=[], exclude=['kernel*'], pin={}, rhel)
  provisioner "shell" {
    only   = ["amazon-ebs.el10"]
    inline = ["# subscription-managed systems get their repos enabled; RHUI/PAYG images skip", "if sudo subscription-manager identity >/dev/null 2>&1; then sudo subscription-manager refresh; sudo subscription-manager repos --disable='*'; sudo subscription-manager repos --enable='rhel-10-for-x86_64-baseos-rpms' --enable='rhel-10-for-x86_64-appstream-rpms' --enable='codeready-builder-for-rhel-10-x86_64-rpms'; else echo 'not subscription-registered (RHUI image): using vendor repos as-is'; fi", "sudo dnf clean all", "sudo dnf -y update --security --exclude=kernel* || { sudo dnf clean all; sudo dnf -y update --security --exclude=kernel*; }", "sudo mkdir -p /var/lib/csis", "( rpm -qa --qf '%%{NAME}-%%{VERSION}-%%{RELEASE}.%%{ARCH}\n' 2>/dev/null || dpkg-query -W -f='$${Package}=$${Version}\n' ) | sort | sudo tee /var/lib/csis/packages.txt >/dev/null"]
  }
  # admin user csisadmin (1 public key(s))
  provisioner "shell" {
    only = ["amazon-ebs.el10"]
    inline = [
      "# mandatory local admin user 'csisadmin' (DESIGN Q2/N9): public keys only",
      "id -u csisadmin >/dev/null 2>&1 || sudo useradd -m -s /bin/bash csisadmin",
      "echo 'csisadmin ALL=(ALL) NOPASSWD:ALL' | sudo tee /etc/sudoers.d/90-csisadmin >/dev/null && sudo chmod 0440 /etc/sudoers.d/90-csisadmin",
      "sudo mkdir -p /home/csisadmin/.ssh && sudo chmod 0700 /home/csisadmin/.ssh",
      "sudo rm -f /home/csisadmin/.ssh/authorized_keys",
      "echo 'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIMIgIcl+Fgs5qoSEa+EphyYGuHUngHf+Wai+/O+0wegN csis-walk-admin' | sudo tee -a /home/csisadmin/.ssh/authorized_keys >/dev/null",
      "sudo touch /home/csisadmin/.ssh/authorized_keys && sudo chmod 0600 /home/csisadmin/.ssh/authorized_keys",
      "sudo chown -R csisadmin:csisadmin /home/csisadmin/.ssh",
    ]
  }
  # identity type 'okta' prerequisites, dormant
  provisioner "shell" {
    only = ["amazon-ebs.el10"]
    inline = [
      "# identity type 'okta' prerequisites (opa-groups): OPA agent, dormant",
      "sudo rpm --import https://dist.scaleft.com/GPG-KEY-OktaPAM-2023",
      "printf '[oktapam-stable]\\nname=Okta PAM Stable - $basearch\\nbaseurl=https://dist.scaleft.com/repos/rpm/stable/rhel/$releasever/$basearch\\ngpgcheck=1\\nrepo_gpgcheck=1\\nenabled=1\\ngpgkey=https://dist.scaleft.com/GPG-KEY-OktaPAM-2023\\n' | sudo tee /etc/yum.repos.d/oktapam-stable.repo",
      "sudo yum install -y scaleft-server-tools",
      "sudo systemctl disable --now sftd || true",
      "sudo rm -f /var/lib/sftd/enrollment.token",
    ]
  }
  # storage type 'ebs' prerequisites
  provisioner "shell" {
    only = ["amazon-ebs.el10"]
    inline = [
      "# storage type 'ebs' declared: no prerequisites to bake (aws-ebs)",
    ]
  }
  # debug session mechanism (ssm)
  provisioner "shell" {
    only = ["amazon-ebs.el10"]
    inline = [
      "# session mechanism 'ssm' (aws-main): SSM agent for debug sessions",
      "sudo yum install -y https://s3.us-east-2.amazonaws.com/amazon-ssm-us-east-2/latest/linux_amd64/amazon-ssm-agent.rpm || sudo yum install -y amazon-ssm-agent",
      "sudo systemctl enable amazon-ssm-agent",
    ]
  }
  # in-bake verification for base image el10: 10 assertion(s)
  provisioner "shell" {
    only = ["amazon-ebs.el10"]
    inline = [
      "set -e",
      "# verify: admin user csisadmin",
      "id -u csisadmin >/dev/null 2>&1",
      "sudo test -f /home/csisadmin/.ssh/authorized_keys",
      "sudo grep -q -- AAAAC3NzaC1lZDI1NTE5AAAAIMIgIcl+Fgs5qoSEa+EphyYGuHUngHf+Wai+/O+0wegN /home/csisadmin/.ssh/authorized_keys",
      "# verify: OPA agent present and dormant",
      "command -v sftd >/dev/null 2>&1 || test -x /usr/sbin/sftd || test -x /usr/bin/sftd",
      "! systemctl is-enabled sftd >/dev/null 2>&1",
      "test ! -e /var/lib/sftd/enrollment.token",
      "# verify: SSM agent baked",
      "command -v amazon-ssm-agent >/dev/null 2>&1 || test -x /usr/bin/amazon-ssm-agent || snap list amazon-ssm-agent >/dev/null 2>&1",
      "systemctl is-enabled amazon-ssm-agent >/dev/null 2>&1 || systemctl is-enabled snap.amazon-ssm-agent.amazon-ssm-agent.service >/dev/null 2>&1",
      "if ! rpm -q scaleft-server-tools >/dev/null 2>&1 && ! { command -v dpkg >/dev/null 2>&1 && dpkg -s scaleft-server-tools >/dev/null 2>&1; }; then printf 'package %s is not installed\\n' scaleft-server-tools >&2; exit 1; fi",
      "( id -u csisadmin ) >/dev/null 2>&1; test $? -eq 0",
    ]
  }
  post-processor "manifest" {
    output     = "manifest.json"
    strip_path = true
  }
}